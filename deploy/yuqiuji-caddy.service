[Unit]
Description=Yuqiuji HTTPS proxy
After=network-online.target yuqiuji.service
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=yuqiuji-caddy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/yuqiuji-caddy
Environment=XDG_CONFIG_HOME=/var/lib/yuqiuji-caddy
ExecStart=/opt/yuqiuji/runtime/caddy run --config /opt/yuqiuji/app/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
